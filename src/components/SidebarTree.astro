---
import type { TreeNode } from '../utils/tree';

interface Props {
  nodes: TreeNode[];
  ancestors: TreeNode[];
  currentNode: TreeNode | null;
  basePath: string;
  depth?: number;
}

const { nodes, ancestors, currentNode, basePath, depth = 0 } = Astro.props;
const indent = depth * 13;

function getTitle(n: TreeNode) {
  return n.note?.data.title || n.wikiEntry?.data.title || n.name;
}
---

{nodes.map(n => {
  const inPath = ancestors.some(a => a.name === n.name && a.depth === n.depth);
  const isActive = !!currentNode && n.name === currentNode.name && n.depth === currentNode.depth;
  const key = n.segments.join('/');
  const href = `${basePath}${key}/`;
  const label = n.type === 'folder' ? n.name : getTitle(n);

  return (
    <div
      class={`tr-item${n.type === 'folder' && inPath ? ' open' : ''}`}
      data-depth={depth}
      data-key={key}
      data-kind={n.type}
      style={`--ind:${indent}px`}
    >
      <div class={`tr${isActive ? ' on' : ''}`} data-href={href}>
        <span class="tr-pad" style={`width:${n.type === 'folder' ? indent : indent + 16}px`}></span>
        {n.type === 'folder' && (
          <button
            class="tr-arr"
            type="button"
            aria-expanded={inPath ? 'true' : 'false'}
            aria-label={`展开或折叠 ${n.name}`}
          >▶</button>
        )}
        <a class="tr-link" href={href}>
          <span class="tr-ic" aria-hidden="true">{n.type === 'folder' ? '' : '◦'}</span>
          <span class="tr-lbl" data-raw={label}>{label}</span>
        </a>
        {n.type === 'folder' && <span class="tr-badge">{n.count}</span>}
      </div>

      {n.type === 'folder' && n.children && (
        <div class="tr-kids">
          <div>
            <Astro.self
              nodes={n.children}
              ancestors={ancestors}
              currentNode={currentNode}
              basePath={basePath}
              depth={depth + 1}
            />
          </div>
        </div>
      )}
    </div>
  );
})}
