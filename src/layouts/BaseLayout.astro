---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';
import '../styles/fonts.ts';
import '../styles/fonts.css';
import '../styles/global.css';

export interface Props {
  title: string;
  activeNav?: 'home' | 'notes' | 'projects' | 'wiki';
  breadcrumbs?: { label: string; href: string }[];
  /** 当前板块强调色（CSS 颜色值或 var(...)），注入 --sec */
  accent?: string;
  /** 是否显示移动端侧栏抽屉开关 */
  hasSidebar?: boolean;
  /** 页面描述，用于 <meta description> 与 og:description */
  description?: string;
  /** Open Graph 类型 */
  ogType?: 'website' | 'article';
  /** OG 卡片图的站内绝对路径，例如 /og/notes/xxx.png */
  ogImage?: string;
}

const {
  title,
  activeNav = 'home',
  breadcrumbs = [],
  accent,
  hasSidebar = false,
  description = SITE.description,
  ogType = 'website',
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = `${title} — ${SITE.title}`;

const navItems = [
  { id: 'notes', label: '笔记', href: '/notes/' },
  { id: 'projects', label: '项目', href: '/projects/' },
  { id: 'wiki', label: 'Wiki', href: '/wiki/' },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0f0e0d" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="zh_CN" />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? SITE.url).href} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? SITE.url).href} />}
  <link rel="preload" href="/fonts/noto-serif-sc-subset.woff2" as="font" type="font/woff2" crossorigin />
  <ClientRouter />
  <script is:inline>
    // 字体预设表：拉丁字体在前（英文数字仍走原字体），汉字回退到 Noto，
    // 否则中文会掉进系统默认衬线（Windows 上是宋体，小字号发虚断笔）。
    // 只在这里定义一次，下方设置面板复用，避免两份表各改各的。
    window.__mzFontPresets = {
      serif: { fh: "'Lora Variable','Noto Serif SC Subset',Georgia,serif", fb: "'Source Serif 4 Variable','Noto Serif SC Subset',Georgia,serif", fm: "'JetBrains Mono Variable','Noto Sans SC Subset',monospace" },
      sans:  { fh: "'DM Sans Variable','Noto Sans SC Subset',system-ui,sans-serif", fb: "'Inter Variable','Noto Sans SC Subset',system-ui,sans-serif", fm: "'JetBrains Mono Variable','Noto Sans SC Subset',monospace" },
      mono:  { fh: "'Space Mono','Noto Sans SC Subset',monospace", fb: "'Atkinson Hyperlegible','Noto Sans SC Subset',system-ui,sans-serif", fm: "'JetBrains Mono Variable','Noto Sans SC Subset',monospace" },
      cn:    { fh: "'Noto Serif SC Subset',Georgia,serif", fb: "'Noto Sans SC Subset',system-ui,sans-serif", fm: "'JetBrains Mono Variable','Noto Sans SC Subset',monospace" }
    };
    // 首屏绘制前应用偏好，避免闪白；换页后由 astro:after-swap 再次应用
    window.__mzPrefs = function () {
      var d = document.documentElement, ls = localStorage;
      d.setAttribute('data-theme', ls.getItem('mz_theme') || 'dark');
      d.style.fontSize = (ls.getItem('mz_base') || '15') + 'px';
      d.style.setProperty('--fs-body', ls.getItem('mz_body') || '1');
      d.style.setProperty('--fs-ui', ls.getItem('mz_ui') || '1');
      d.style.setProperty('--content-width', (ls.getItem('mz_width') || '760') + 'px');
      var P = window.__mzFontPresets[ls.getItem('mz_font') || 'serif'];
      d.style.setProperty('--fh', P.fh);
      d.style.setProperty('--fb', P.fb);
      d.style.setProperty('--fm', P.fm);
    };
    window.__mzPrefs();
    // ClientRouter 换页时会用新文档的 <html> 属性覆盖，这里补回主题/字号
    document.addEventListener('astro:after-swap', window.__mzPrefs);
  </script>
</head>
<body style={accent ? `--sec:${accent}` : undefined}>
  <div class="pbar" id="pbar" style="width:0"></div>
  <div class="app">
    <nav class="nav" data-pagefind-ignore>
      {hasSidebar && <button class="nav-ic nav-menu" id="btn-menu" title="目录" aria-label="打开目录">☰</button>}
      <a class="nav-logo" href="/">mimi<span>zh</span></a>
      {breadcrumbs.length > 0 && (
        <div class="nav-bc">
          <a class="nav-bc-item link" href="/">~</a>
          {breadcrumbs.map((bc, i) => (
            <>
              <span class="nav-bc-sep">/</span>
              {i === breadcrumbs.length - 1
                ? <span class="nav-bc-item cur">{bc.label}</span>
                : <a class="nav-bc-item link" href={bc.href}>{bc.label}</a>
              }
            </>
          ))}
        </div>
      )}
      <div class="nav-links">
        {navItems.map(n => (
          <a class={`nav-btn${activeNav === n.id ? ' on' : ''}`} href={n.href}>{n.label}</a>
        ))}
      </div>
      <div class="nav-sep"></div>
      <button class="nav-ic" title="搜索 ⌘K" aria-label="搜索" id="btn-search">⌕</button>
      <button class="nav-ic" title="切换主题" aria-label="切换主题" id="btn-theme">◐</button>
      <button class="nav-ic" title="显示设置" aria-label="显示设置" id="btn-settings">&#9881;</button>
    </nav>
    <slot />
  </div>

  <!-- 图片放大 -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片预览"><img alt="" /></div>

  <!-- Search overlay -->
  <div class="search-ov" id="search-ov">
    <div class="search-box">
      <div class="search-top">
        <span class="search-ic">⌕</span>
        <input class="search-in" id="search-in" placeholder="搜索笔记、项目、Wiki…" autocomplete="off" />
        <span class="search-esc">ESC</span>
      </div>
      <div class="search-results" id="search-results">
        <div class="s-empty">输入关键词开始搜索</div>
      </div>
      <div class="s-footer">
        <span class="s-hint"><span class="s-kbd">↑↓</span>选择</span>
        <span class="s-hint"><span class="s-kbd">↵</span>打开</span>
        <span class="s-hint"><span class="s-kbd">ESC</span>关闭</span>
      </div>
    </div>
  </div>

  <!-- Settings panel -->
  <div class="settings-panel" id="settings-panel">
    <div class="sp-header">
      <span>显示设置</span>
      <button class="sp-close" id="sp-close" aria-label="关闭">&times;</button>
    </div>
    <div class="sp-body">
      <label class="sp-row">
        <span class="sp-label">基础字号 <span class="sp-val" id="sp-val-base">15px</span></span>
        <input type="range" id="sp-base" min="12" max="22" value="15" step="0.5" />
      </label>
      <label class="sp-row">
        <span class="sp-label">正文字号 <span class="sp-val" id="sp-val-body">1.0x</span></span>
        <input type="range" id="sp-body" min="0.7" max="1.5" value="1.0" step="0.05" />
      </label>
      <label class="sp-row">
        <span class="sp-label">界面字号 <span class="sp-val" id="sp-val-ui">1.0x</span></span>
        <input type="range" id="sp-ui" min="0.7" max="1.5" value="1.0" step="0.05" />
      </label>
      <label class="sp-row">
        <span class="sp-label">内容宽度 <span class="sp-val" id="sp-val-width">760px</span></span>
        <input type="range" id="sp-width" min="520" max="1100" value="760" step="10" />
      </label>
      <label class="sp-row">
        <span class="sp-label">字体方案</span>
        <select id="sp-font" style="font-family:var(--fm);font-size:calc(.72rem * var(--fs-ui));color:var(--tx);background:var(--sf);border:1px solid var(--bd);border-radius:4px;padding:.3rem .45rem;cursor:pointer;outline:none;width:100%">
          <option value="serif">衬线 · Lora + Source Serif 4</option>
          <option value="sans">无衬线 · DM Sans + Inter</option>
          <option value="mono">等宽优先 · Space Mono + Atkinson</option>
          <option value="cn">中文优化 · Noto Serif SC + Noto Sans SC</option>
        </select>
      </label>
      <button class="sp-reset" id="sp-reset">恢复默认</button>
    </div>
  </div>

  <script is:inline>
  (function () {
    var D = document;
    var $ = function (id) { return D.getElementById(id); };
    var defaults = { base: 15, body: 1, ui: 1, width: 760 };
    var fontPresets = window.__mzFontPresets;
    function num(key, def) { var v = localStorage.getItem('mz_' + key); return v !== null ? parseFloat(v) : def; }
    function setVal(id, text) { var el = $(id); if (el) el.textContent = text; }
    function setInput(id, v) { var el = $(id); if (el) el.value = v; }

    function applyBase(s)  { D.documentElement.style.fontSize = s + 'px'; setInput('sp-base', s); setVal('sp-val-base', s + 'px'); }
    function applyBody(m)  { D.documentElement.style.setProperty('--fs-body', m); setInput('sp-body', m); setVal('sp-val-body', m.toFixed(2) + 'x'); }
    function applyUI(m)    { D.documentElement.style.setProperty('--fs-ui', m);   setInput('sp-ui', m);   setVal('sp-val-ui', m.toFixed(2) + 'x'); }
    function applyWidth(w) { D.documentElement.style.setProperty('--content-width', w + 'px'); setInput('sp-width', w); setVal('sp-val-width', w + 'px'); }
    function applyFont(k) {
      var p = fontPresets[k] || fontPresets.serif;
      D.documentElement.style.setProperty('--fh', p.fh);
      D.documentElement.style.setProperty('--fb', p.fb);
      D.documentElement.style.setProperty('--fm', p.fm);
      setInput('sp-font', k);
    }
    var appliers = { base: applyBase, body: applyBody, ui: applyUI, width: applyWidth };

    // ── 搜索：优先 Pagefind 全文索引，构建产物不存在时（dev）回退到 JSON 索引 ──
    var searchIdx = [];
    var selIdx = -1;
    var reqId = 0;
    var pagefind = null;
    var pagefindTried = false;

    function loadIndex() {
      if (searchIdx.length) return;
      fetch('/search-index.json').then(function (r) { return r.json(); })
        .then(function (j) { searchIdx = j; }).catch(function () {});
    }

    function getPagefind() {
      if (pagefindTried) return Promise.resolve(pagefind);
      pagefindTried = true;
      // 该脚本是 is:inline，不经 Vite 处理，动态 import 会原样保留
      return import('/pagefind/pagefind.js')
        .then(function (m) {
          return Promise.resolve(m.options ? m.options({ excerptLength: 24 }) : null)
            .then(function () { return m.init ? m.init() : null; })
            .then(function () { pagefind = m; return m; });
        })
        .catch(function () { pagefind = null; return null; });
    }
    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function hl(s, q) {
      var t = esc(s), i = t.toLowerCase().indexOf(q);
      if (i < 0 || !q) return t;
      return t.slice(0, i) + '<mark>' + t.slice(i, i + q.length) + '</mark>' + t.slice(i + q.length);
    }
    function renderEmpty(box, q) {
      box.innerHTML = '<div class="s-empty">没有找到「' + esc(q) + '」</div>';
    }

    function updateResults(q) {
      var box = $('search-results'); if (!box) return;
      var ql = q.toLowerCase().trim();
      selIdx = -1;
      if (!ql) { box.innerHTML = '<div class="s-empty">输入关键词开始搜索</div>'; return; }

      var my = ++reqId;
      getPagefind().then(function (pf) {
        if (my !== reqId) return;
        if (!pf) { fallbackResults(box, q, ql); return; }
        return pf.search(q).then(function (s) {
          if (my !== reqId) return;
          return Promise.all(s.results.slice(0, 10).map(function (r) { return r.data(); }));
        }).then(function (rs) {
          if (my !== reqId || !rs) return;
          if (!rs.length) { renderEmpty(box, q); return; }
          box.innerHTML = rs.map(function (r) {
            var path = r.url;
            try { path = decodeURI(r.url); } catch (e) {}
            return '<a class="sr" href="' + esc(r.url) + '">'
              + '<div class="sr-name">' + esc((r.meta && r.meta.title) || path) + '</div>'
              + '<div class="sr-path">' + esc(path) + '</div>'
              // excerpt 由 Pagefind 自己生成（含 <mark>），是可信 HTML
              + '<div class="sr-exc">' + r.excerpt + '</div></a>';
          }).join('');
        });
      }).catch(function () { fallbackResults(box, q, ql); });
    }

    function fallbackResults(box, q, ql) {
      var res = searchIdx.filter(function (i) {
        return i.title.toLowerCase().includes(ql) || (i.excerpt || '').toLowerCase().includes(ql) || i.path.toLowerCase().includes(ql);
      }).sort(function (a, b) {
        return (b.title.toLowerCase().includes(ql) ? 1 : 0) - (a.title.toLowerCase().includes(ql) ? 1 : 0);
      }).slice(0, 10);
      if (!res.length) { renderEmpty(box, q); return; }
      box.innerHTML = res.map(function (r) {
        return '<a class="sr" href="' + esc(r.path) + '">'
          + '<div class="sr-name">' + hl(r.title, ql) + '</div>'
          + '<div class="sr-path">' + hl(r.path, ql) + '</div>'
          + '<div class="sr-exc">' + hl(r.excerpt || '', ql) + '</div></a>';
      }).join('');
    }
    function moveSel(d) {
      var items = D.querySelectorAll('#search-results .sr');
      if (!items.length) return;
      selIdx = (selIdx + d + items.length) % items.length;
      items.forEach(function (el, i) { el.classList.toggle('sel', i === selIdx); });
      items[selIdx].scrollIntoView({ block: 'nearest' });
    }
    function openSearch() {
      var ov = $('search-ov'); if (!ov) return;
      loadIndex();
      getPagefind();
      ov.classList.add('open');
      var inp = $('search-in');
      if (inp) { inp.value = ''; inp.focus(); }
      updateResults('');
    }
    function closeSearch() { var ov = $('search-ov'); if (ov) ov.classList.remove('open'); }

    // ── 每页绑定（ClientRouter 会换掉 body，标志随之失效）──
    function bindPage() {
      if (D.body.dataset.mzBound) return;
      D.body.dataset.mzBound = '1';

      applyBase(num('base', defaults.base));
      applyBody(num('body', defaults.body));
      applyUI(num('ui', defaults.ui));
      applyWidth(num('width', defaults.width));
      applyFont(localStorage.getItem('mz_font') || 'serif');

      ['base', 'body', 'ui', 'width'].forEach(function (k) {
        var el = $('sp-' + k); if (!el) return;
        el.addEventListener('input', function () {
          var v = parseFloat(this.value);
          appliers[k](v);
          localStorage.setItem('mz_' + k, v);
        });
      });
      var fsel = $('sp-font');
      if (fsel) fsel.addEventListener('change', function () { applyFont(this.value); localStorage.setItem('mz_font', this.value); });

      var reset = $('sp-reset');
      if (reset) reset.addEventListener('click', function () {
        applyBase(defaults.base);   localStorage.setItem('mz_base', defaults.base);
        applyBody(defaults.body);   localStorage.setItem('mz_body', defaults.body);
        applyUI(defaults.ui);       localStorage.setItem('mz_ui', defaults.ui);
        applyWidth(defaults.width); localStorage.setItem('mz_width', defaults.width);
        applyFont('serif');         localStorage.setItem('mz_font', 'serif');
      });

      var bs = $('btn-settings');
      if (bs) bs.addEventListener('click', function (e) { e.stopPropagation(); $('settings-panel').classList.toggle('open'); });
      var spc = $('sp-close');
      if (spc) spc.addEventListener('click', function () { $('settings-panel').classList.remove('open'); });

      var bt = $('btn-theme');
      if (bt) bt.addEventListener('click', function () {
        var next = D.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        D.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('mz_theme', next);
        D.dispatchEvent(new CustomEvent('mz:theme'));
      });

      var bsr = $('btn-search');
      if (bsr) bsr.addEventListener('click', openSearch);
      var si = $('search-in');
      if (si) si.addEventListener('input', function () { updateResults(this.value); });
      var ov = $('search-ov');
      if (ov) ov.addEventListener('click', function (e) { if (e.target === this) closeSearch(); });

      var bm = $('btn-menu');
      if (bm) bm.addEventListener('click', function () {
        var sb = $('sb'), scr = $('sb-scrim');
        if (sb) sb.classList.toggle('open');
        if (scr) scr.classList.toggle('open');
      });

      // 图片放大
      var lb = $('lightbox');
      if (lb) {
        D.querySelectorAll('.doc-body img').forEach(function (img) {
          img.addEventListener('click', function () {
            var big = lb.querySelector('img');
            big.src = img.currentSrc || img.src;
            big.alt = img.alt || '';
            lb.classList.add('open');
          });
        });
        lb.addEventListener('click', function () { this.classList.remove('open'); });
      }

      // Wiki 页 PDF 阅读器的展开/收起
      D.querySelectorAll('[data-pdf-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var rd = btn.closest('.pdf-rd');
          if (!rd) return;
          var fr = rd.querySelector('.pdf-fr');
          if (!fr) return;
          var big = fr.style.height === '660px';
          fr.style.height = big ? '450px' : '660px';
          btn.textContent = big ? '展开' : '收起';
        });
      });

      updateProgress();
    }

    // ── 滚动：阅读进度 + 目录高亮 ──
    var ticking = false;
    function updateProgress() {
      var bar = $('pbar');
      var h = D.documentElement.scrollHeight - window.innerHeight;
      if (bar) bar.style.width = h > 0 ? Math.min(100, (window.scrollY / h) * 100) + '%' : '0';

      var lis = D.querySelectorAll('.toc-li');
      if (lis.length) {
        var cur = '';
        lis.forEach(function (li) {
          var id = li.getAttribute('data-id'); if (!id) return;
          var el = D.getElementById(id);
          if (el && el.getBoundingClientRect().top < 140) cur = id;
        });
        if (!cur && lis[0]) cur = lis[0].getAttribute('data-id');
        lis.forEach(function (li) { li.classList.toggle('on', li.getAttribute('data-id') === cur); });
        D.querySelectorAll('.docs-sb-link').forEach(function (l) {
          l.classList.toggle('on', l.getAttribute('data-id') === cur);
        });
      }
      ticking = false;
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateProgress);
    }

    if (!window.__mzGlobalHook) {
      window.__mzGlobalHook = 1;
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      D.addEventListener('astro:page-load', bindPage);
      D.addEventListener('keydown', function (e) {
        var ov = $('search-ov');
        var open = ov && ov.classList.contains('open');
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); return; }
        if (e.key === 'Escape') {
          closeSearch();
          var sp = $('settings-panel'); if (sp) sp.classList.remove('open');
          var lb = $('lightbox'); if (lb) lb.classList.remove('open');
        }
        if (!open) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); moveSel(1); }
        if (e.key === 'ArrowUp')   { e.preventDefault(); moveSel(-1); }
        if (e.key === 'Enter') {
          var sel = D.querySelector('#search-results .sr.sel') || D.querySelector('#search-results .sr');
          if (sel) { e.preventDefault(); location.href = sel.getAttribute('href'); }
        }
      });
      D.addEventListener('click', function (e) {
        var panel = $('settings-panel');
        if (panel && panel.classList.contains('open') && !panel.contains(e.target) && e.target !== $('btn-settings')) {
          panel.classList.remove('open');
        }
      });
    }

    bindPage();
  })();
  </script>
</body>
</html>
