---
import { slug } from 'github-slugger';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { buildWikiTree, findNode, getAncestors, getFolderColor } from '../../utils/tree';
import { getBacklinksFor } from '../../utils/backlinks';
import type { TreeNode } from '../../utils/tree';

export async function getStaticPaths() {
  const tree = await buildWikiTree();
  const paths: { params: { slug: string } }[] = [];
  function walk(nodes: TreeNode[], parent: string[]) {
    for (const node of nodes) {
      const segs = [...parent, node.name];
      paths.push({ params: { slug: segs.join('/') } });
      if (node.type === 'folder' && node.children) walk(node.children, segs);
    }
  }
  walk(tree, []);
  return paths;
}

const { slug: slugParam } = Astro.params;
const segments = (slugParam || '').split('/').filter(Boolean);

const tree = await buildWikiTree();
const node = findNode(tree, segments);
if (!node) return Astro.redirect('/wiki/');

const ancestors = getAncestors(tree, segments);
const isNote = node.type === 'note';

const breadcrumbs = [
  { label: 'Wiki', href: '/wiki/' },
  ...ancestors.map((a, i) => ({
    label: a.type === 'folder' ? a.name : (a.wikiEntry?.data.title || ''),
    href: `/wiki/${segments.slice(0, i + 1).join('/')}/`,
  })),
];

// Page title
const pageTitle = isNote ? (node.wikiEntry?.data.title || '') : node.name;

// For folder: collect children
let folderChildren: TreeNode[] = [];
if (!isNote && node.children) folderChildren = node.children;

const sectionColor = getFolderColor(node.segments.join('/'));

// 目录只显示纯文本，去掉行内 markdown 记号
function plainText(s: string) {
  return s
    .replace(/`([^`]*)`/g, '$1')
    .replace(/\*\*([^*]*)\*\*/g, '$1')
    .replace(/\*([^*]*)\*/g, '$1')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .trim();
}

// For note: render content
let Content: any;
let entry: any = null;
let toc: { id: string; label: string; level: number }[] = [];
let backlinks: { url: string; title: string }[] = [];
if (isNote && node.wikiEntry) {
  entry = node.wikiEntry;
  const rendered = await node.wikiEntry.render();
  Content = rendered.Content;

  backlinks = await getBacklinksFor(`/wiki/${node.segments.join('/')}/`);

  const headingRe = /^(#{2,4})\s+(.+)$/gm;
  let m;
  while ((m = headingRe.exec(node.wikiEntry.body || '')) !== null) {
    toc.push({ id: slug(m[2]), label: plainText(m[2]), level: m[1].length });
  }
}

const secEntries = ancestors.length > 0
  ? (ancestors[ancestors.length - 2]?.children || []).filter(c => c.type === 'note' && c.name !== node?.name)
  : [];
---

<BaseLayout
  title={`${pageTitle} · Wiki`}
  activeNav="wiki"
  breadcrumbs={breadcrumbs}
  accent={sectionColor}
  hasSidebar={true}
  ogType={isNote ? 'article' : 'website'}
  ogImage={isNote ? `/og/wiki/${node.segments.join('/')}.png` : undefined}
  description={isNote
    ? (entry?.data.description || `${pageTitle} — Wiki 条目`)
    : `${node.name} 分类下的 ${node.count} 条 Wiki 笔记`}
>
  <div class="main">
    <Sidebar nodes={tree} ancestors={ancestors} currentNode={node} basePath="/wiki/" label="Wiki" />

    {!isNote ? (
      <div class="main-col">
        <div class="page fu">
          <div class="ph">
            <div class="pt" style="display:flex;align-items:center;gap:.5rem">
              <span style={`width:8px;height:8px;border-radius:50%;background:${sectionColor};display:inline-block`}></span>
              {node.name}
            </div>
            <div class="pd">{node.count} 条笔记</div>
          </div>

          {folderChildren.some(c => c.type === 'folder') && (
            <div class="wiki-grid">
              {folderChildren.filter(c => c.type === 'folder').map(f => (
                <a class="wiki-sc" href={`/wiki/${f.segments.join('/')}/`} style={`--cc:${getFolderColor(f.segments.join('/'))}`}>
                  <div class="wiki-sc-dot" style={`background:${getFolderColor(f.segments.join('/'))}`}></div>
                  <div class="wiki-sc-name">{f.name}</div>
                  <div class="wiki-sc-desc">{f.count} 条笔记</div>
                </a>
              ))}
            </div>
          )}

          <div class="fl">
            {folderChildren.filter(c => c.type === 'note').map(n => (
              <a class="fr" href={`/wiki/${n.segments.join('/')}/`}>
                <div>
                  <div class="fn" style="display:flex;align-items:center;gap:.45rem">
                    {n.wikiEntry?.data.title || n.name}
                    {n.pdf && <span class="pdf-badge">PDF</span>}
                  </div>
                  <div class="fe">{n.wikiEntry?.data.description || ''}</div>
                </div>
                <div class="fm-col"><div class="fd">{n.resolvedDate || n.wikiEntry?.data.date || ''}</div></div>
              </a>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="main-col">
        <div class="doc-layout">
          <div class="doc-main fu" data-pagefind-body>
            <a class="back" data-pagefind-ignore href={`/wiki/${node.segments.slice(0, -1).join('/')}/`}>
              ← {ancestors.length > 1 ? ancestors[ancestors.length - 2]?.name : 'Wiki'}
            </a>
            <span class="doc-cat" style={`color:${sectionColor}`}>
              Wiki / {node.segments.slice(0, -1).join(' / ') || ''}
            </span>
            <h1 class="doc-title">{entry?.data.title}</h1>
            <div class="doc-sub">{entry?.data.description}</div>
            <div class="doc-meta" style="font-family:var(--fm)">
              <span>{node.resolvedDate || entry?.data.date}</span>
              {node.pdf && <><span>·</span><span style="color:var(--paper)">PDF 附件</span></>}
            </div>
            {node.pdf && (
              <div class="pdf-rd" data-pagefind-ignore>
                <div class="pdf-hd">
                  <span class="pdf-nm"><span class="pdf-dot"></span>PDF · {entry?.data.title}</span>
                  <div class="pdf-acts">
                    <button class="pdf-ab" type="button" data-pdf-toggle>展开</button>
                    <a class="pdf-ab" href={node.pdf} target="_blank" rel="noreferrer">新标签 ↗</a>
                  </div>
                </div>
                <iframe class="pdf-fr" src={node.pdf} style="height:450px" title={entry?.data.title}></iframe>
              </div>
            )}
            <div class="doc-body">
              {Content && <Content />}
            </div>

            {backlinks.length > 0 && (
              <section class="backlinks" data-pagefind-ignore aria-label="反向链接">
                <div class="backlinks-lbl">被这些笔记引用</div>
                <ul class="backlinks-list">
                  {backlinks.map(b => (
                    <li><a href={b.url}>{b.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
          </div>
          {(toc.length > 0 || secEntries.length > 0) && (
            <nav class="doc-toc-col" data-pagefind-ignore aria-label="本页目录">
              {toc.length > 0 && (
                <>
                  <div class="doc-toc-lbl">目录</div>
                  <ul class="toc-ul">
                    {toc.map(t => (
                      <li class={`toc-li${t.level === 3 ? ' h3' : t.level === 4 ? ' h4' : ''}`} data-id={t.id}>
                        <a href={`#${t.id}`} style="display:block;color:inherit;text-decoration:none">{t.label}</a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {secEntries.length > 0 && (
                <>
                  <div class="doc-toc-lbl" style="margin-top:1.6rem">本节其他</div>
                  <ul class="toc-ul">
                    {secEntries.map(e => (
                      <li class="toc-li">
                        <a href={`/wiki/${e.segments.join('/')}/`} style="display:block;color:inherit;text-decoration:none">
                          {e.wikiEntry?.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </nav>
          )}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
